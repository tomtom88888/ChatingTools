# ---- Never commit real chat data ----
*.txt
*.zip
!test/fixtures/*.txt
exports/
chat_exports/
*.jsonl

# ---- Flutter / Dart ----
.dart_tool/
.packages
.pub-cache/
.pub/
build/
coverage/
*.log
.flutter-plugins
.flutter-plugins-dependencies

# ---- IDE ----
.idea/
.vscode/
*.iml
*.iws
.DS_Store

# ---- Android ----
android/.gradle/
android/captures/
android/local.properties
android/key.properties
android/app/*.jks
android/app/*.keystore
# The one exception: a deliberately public key for sideload builds, so every
# build signs the same and APKs can upgrade each other. Never a release key.
!android/app/sideload.keystore
android/.cxx/
android/app/src/main/java/io/flutter/plugins/GeneratedPluginRegistrant.java
*.apk
*.aab

# ---- iOS ----
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Flutter/ephemeral/
ios/Flutter/app.flx
ios/Flutter/app.zip
ios/Flutter/flutter_assets/
ios/ServiceDefinitions.json
ios/Runner/GeneratedPluginRegistrant.*
ios/Pods/
ios/.symlinks/
ios/Podfile.lock
*.ipa

# ---- Secrets ----
.env
.env.*
